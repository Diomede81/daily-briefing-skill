{
  "port": 3020,
  "defaultTimezone": "Europe/London",
  "briefs": [
    {
      "name": "Daily Briefing",
      "enabled": true,
      "schedule": "00 08 * * *",
      "timezone": "Europe/London",
      "delivery": {
        "agent": "max",
        "recipients": [
          "user@example.com"
        ]
      },
      "sources": [
        {
          "name": "Example RSS Feed",
          "type": "rss",
          "url": "https://example.com/feed.xml",
          "enabled": true,
          "config": {
            "maxItems": 10
          }
        }
      ]
    }
  ],
  "sourceTemplates": {},
  "aiConfig": {
    "provider": "openclaw",
    "model": "anthropic/claude-sonnet-4-5",
    "maxTokens": 2000,
    "temperature": 0.7
  },
  "delivery": {
    "default": {
      "mode": "summary",
      "channels": [
        {
          "type": "email",
          "enabled": true,
          "target": "user@example.com",
          "agent": "max"
        }
      ]
    }
  },
  "lastRun": null
}
